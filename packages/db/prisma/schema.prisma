// ============================================================
// REFERRALS — tracks when a past couple refers a new inquiry (migration 018)
// ============================================================
model Referral {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId           String    @map("venue_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  referringClientId String?   @map("referring_client_id") @db.Uuid
  referringName     String?   @map("referring_name")
  referredClientId  String?   @map("referred_client_id") @db.Uuid
  referredInquiryId String?   @map("referred_inquiry_id") @db.Uuid
  // 'self_reported' | 'sage_extracted' | 'manual'
  source            String    @default("self_reported")
  converted         Boolean?
  convertedAt       DateTime? @map("converted_at") @db.Timestamptz(6)
  notes             String?

  venue           Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  referringClient Client?  @relation("ReferralFrom", fields: [referringClientId], references: [id], onDelete: SetNull)
  referredClient  Client?  @relation("ReferralTo", fields: [referredClientId], references: [id], onDelete: SetNull)
  referredInquiry Inquiry? @relation(fields: [referredInquiryId], references: [id], onDelete: SetNull)

  @@map("referrals")
}

