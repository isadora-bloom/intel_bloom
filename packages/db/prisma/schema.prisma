// ============================================================
// DEMO EVENTS — granular interaction tracking (migration 010)
// ============================================================
model DemoEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  eventType       String    @map("event_type")
  pagePath        String?   @map("page_path")
  role            String?
  venueSlug       String?   @map("venue_slug")
  durationMs      Int?      @map("duration_ms")
  scrollDepthPct  Int?      @map("scroll_depth_pct")
  featureName     String?   @map("feature_name")
  featureDetail   String?   @map("feature_detail")
  elementId       String?   @map("element_id")
  elementText     String?   @map("element_text")
  viewportWidth   Int?      @map("viewport_width")
  viewportHeight  Int?      @map("viewport_height")
  isMobile        Boolean   @default(false) @map("is_mobile")

  session         DemoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("demo_events")
}
