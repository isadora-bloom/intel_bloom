// ============================================================
// EMAIL THREADS — Gmail thread tracking
// ============================================================
model EmailThread {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId         String    @map("venue_id") @db.Uuid
  clientId        String?   @map("client_id") @db.Uuid
  gmailThreadId   String    @map("gmail_thread_id")
  subject         String?
  firstMessageAt  DateTime? @map("first_message_at") @db.Timestamptz(6)
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz(6)
  messageCount    Int       @default(0) @map("message_count")
  direction       String?
  isInquiry       Boolean   @default(false) @map("is_inquiry")
  isSageHandled   Boolean   @default(false) @map("is_sage_handled")

  venue    Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages EmailMessage[]

  @@unique([venueId, gmailThreadId])
  @@map("email_threads")
}

// ============================================================
// EMAIL MESSAGES — individual email messages
// ============================================================
model EmailMessage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId           String    @map("venue_id") @db.Uuid
  threadId          String    @map("thread_id") @db.Uuid
  gmailMessageId    String    @map("gmail_message_id")
  direction         String
  fromAddress       String?   @map("from_address")
  toAddress         String?   @map("to_address")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  subject           String?
  bodyPreview       String?   @map("body_preview")
  extractedName     String?   @map("extracted_name")
  extractedEventDate DateTime? @map("extracted_event_date") @db.Date
  extractedSignals  Json?     @map("extracted_signals")

  venue  Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  thread EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([venueId, gmailMessageId])
  @@map("email_messages")
}

// ============================================================
// WEBSITE SESSIONS — individual visitor sessions
// ============================================================
model WebsiteSession {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId                String    @map("venue_id") @db.Uuid
  sessionId              String?   @map("session_id")
  sessionDate            DateTime? @map("session_date") @db.Date
  source                 String?
  medium                 String?
  campaign               String?
  landingPage            String?   @map("landing_page")
  pagesViewed            String[]  @map("pages_viewed")
  pageCount              Int?      @map("page_count")
  sessionDurationSeconds Int?      @map("session_duration_seconds")
  isReturnVisitor        Boolean   @default(false) @map("is_return_visitor")
  visitNumber            Int?      @map("visit_number")
  converted              Boolean   @default(false)
  linkedInquiryId        String?   @map("linked_inquiry_id") @db.Uuid
  linkedClientId         String?   @map("linked_client_id") @db.Uuid

  venue        Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  linkedClient Client? @relation("WebsiteSessionClient", fields: [linkedClientId], references: [id], onDelete: SetNull)

  @@map("website_sessions")
}

// ============================================================
// VENDOR AVAILABILITY — per-date vendor availability
// ============================================================
model VendorAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  date      DateTime @db.Date
  available Boolean  @default(true)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  venue  Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@map("vendor_availability")
}

// ============================================================
// DEMO SESSIONS — tracks demo visitors (migration 010)
// ============================================================
model DemoSession {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  role            String
  venueId         String?   @map("venue_id") @db.Uuid
