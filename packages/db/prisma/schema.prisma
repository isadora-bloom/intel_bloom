generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

// ============================================================
// VENUES
// ============================================================
model Venue {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name        String
  slug        String   @unique
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city        String
  state       String
  zip         String
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)

  // Location calibration
  noaaStationId    String? @map("noaa_station_id")
  noaaStationName  String? @map("noaa_station_name")
  fedDistrict      Int?    @map("fed_district")
  googleTrendsMetro String? @map("google_trends_metro")
  competitorRadiusMiles Int @default(30) @map("competitor_radius_miles")

  // Subscription
  plan               String  @default("founder")
  monthlyPriceCents  Int     @default(25000) @map("monthly_price_cents")

  // Organisation
  organisationId String? @map("organisation_id") @db.Uuid

  // Branding
  region         String?
  countyFips     String?  @map("county_fips")
  logoUrl        String?  @map("logo_url")
  primaryColor   String?  @default("#1A6B6B") @map("primary_color")
  secondaryColor String?  @default("#B07080") @map("secondary_color")
  fontFamily     String?  @default("system") @map("font_family")
  customDomain   String?  @map("custom_domain")

  // Sage AI config
  sageTone             String?  @default("warm_professional") @map("sage_tone")
  sageGreeting         String?  @map("sage_greeting")
  sageAutoReply        Boolean  @default(true) @map("sage_auto_reply")
  sageVoiceDescription String?  @map("sage_voice_description")

  // Vendor & packages
  vendorFitWeights Json? @map("vendor_fit_weights")
  packages         Json?

  // Capacity / pricing
  demandPremiumThreshold Int @default(5) @map("demand_premium_threshold")
  maxEventsPerMonth      Int? @map("max_events_per_month")

  // Integrations
  honeybookApiKey       String? @map("honeybook_api_key")
  knotVenueId           String? @map("knot_venue_id")
  googlePlaceId         String? @map("google_place_id")
  timezone              String  @default("America/New_York")
  onboardingComplete    Boolean @default(false) @map("onboarding_complete")
  gmailOauthToken       String? @map("gmail_oauth_token")
  ga4PropertyId         String? @map("ga4_property_id")
  googleAdsCustomerId   String? @map("google_ads_customer_id")
  instagramBusinessId   String? @map("instagram_business_id")
  trendsCustomTerms     String[] @map("trends_custom_terms")
  calendlyApiKey        String? @map("calendly_api_key")

  // Aggregate pool
  contributesToBenchmark Boolean @default(true) @map("contributes_to_benchmark")

  // Relations — original
  organisation          Organisation? @relation(fields: [organisationId], references: [id])
  venueUsers            VenueUser[]
  clients               Client[]
  inquiries             Inquiry[]
  tours                 Tour[]
  uploads               Upload[]
  planningEvents        PlanningEvent[]
  vendors               Vendor[]
  clientVendors         ClientVendor[]
  annotations           Annotation[]
  weatherForecasts      WeatherForecast[]
  competitorLandscapes  MacroCompetitorLandscape[]
  matchingQueue         MatchingQueue[]
  patternBenchmarks     PatternBenchmark[]
  marketPulse           MarketPulse[]
  sourceTouchpoints     ClientSourceTouchpoint[]
  // Relations — added (migrations 005, 015, 017, 018, 019)
  leads                 Lead[]
  preInquirySignals     PreInquirySignal[]
  channelSpend          ChannelSpend[]
  reviews               Review[]
  reviewLanguage        ReviewLanguage[]
  referrals             Referral[]
  socialPosts           SocialPost[]
  socialApiConnections  SocialApiConnection[]
  websiteTraffic        WebsiteTraffic[]
  // Relations — added (new models)
  anomalyDetections     AnomalyDetection[]
  lostDeals             LostDeal[]
  campaigns             Campaign[]
  responseAlerts        ResponseAlert[]
  revenueForecast       RevenueForecast[]
  venueHealth           VenueHealth[]
  venueCapacity         VenueCapacity[]
  aiUsageLogs           AiUsageLog[]
  dataAccessLogs        DataAccessLog[]
  weeklyInsights        WeeklyInsight[]
  customerHealth        CustomerHealth[]
  contentTouchpoints    ContentTouchpoint[]
  emailThreads          EmailThread[]
  emailMessages         EmailMessage[]
  websiteSessions       WebsiteSession[]
  userInvitations       UserInvitation[]
  userSessions          UserSession[]
  vendorAvailability    VendorAvailability[]

  @@map("venues")
}

// ============================================================
// VENUE USERS
// ============================================================
model VenueUser {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId         String    @map("venue_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            String    @default("member")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  organisationId  String?   @map("organisation_id") @db.Uuid
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  isActive        Boolean   @default(true) @map("is_active")
  invitedBy       String?   @map("invited_by") @db.Uuid

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@unique([venueId, userId])
  @@map("venue_users")
}

// ============================================================
// CLIENTS
// ============================================================
model Client {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Identity
  namePrimary   String  @map("name_primary")
  namePartner   String? @map("name_partner")
  emailPrimary  String? @map("email_primary")
  emailPartner  String? @map("email_partner")
  phonePrimary  String? @map("phone_primary")
  phonePartner  String? @map("phone_partner")

  // Event
  eventDate          DateTime? @map("event_date") @db.Date
  eventDateConfirmed Boolean   @default(false) @map("event_date_confirmed")
  package            String?
  guestCountInitial  Int?      @map("guest_count_initial")
  guestCountFinal    Int?      @map("guest_count_final")
  revenueCents       Int?      @map("revenue_cents")

  // Status
  status String @default("inquiry")

  // Matching
  confidenceScore Int @default(100) @map("confidence_score")

  // Source
  firstTouchPlatform          String?   @map("first_touch_platform")
  firstTouchDate              DateTime? @map("first_touch_date") @db.Timestamptz(6)
  selfReportedSource          String?   @map("self_reported_source")
  resolvedSource              String?   @map("resolved_source")
  resolvedSourceConfidence    Int?      @map("resolved_source_confidence")
  acquisitionCostCents        Int?      @map("acquisition_cost_cents")
  referrerClientId            String?   @map("referrer_client_id") @db.Uuid
  referrerName                String?   @map("referrer_name")
  competingVenues             String[]  @map("competing_venues")

  // Pre-inquiry session
  sessionPagesVisited String[]  @map("session_pages_visited")
  sessionCount        Int?      @map("session_count")
  sessionSourceUrl    String?   @map("session_source_url")
  sessionData         Json?     @map("session_data")

  // Planning scores
  complexityScore     Int?  @map("complexity_score")
  stressFlags         Json? @map("stress_flags")
  familyDynamicsFlags Json? @map("family_dynamics_flags")

  // Event layer
  weatherEventDate      Json?  @map("weather_event_date")
  weatherDifficultyScore Int?  @map("weather_difficulty_score")
  staffingHoursActual   Int?   @map("staffing_hours_actual")
  dayOfComplexity       Int?   @map("day_of_complexity")

  // Reputation (snapshot fields from 001)
  reviewLeft          Boolean?  @map("review_left")
  reviewPlatform      String?   @map("review_platform")
  reviewStarRating    Decimal?  @map("review_star_rating") @db.Decimal(2, 1)
  reviewDate          DateTime? @map("review_date") @db.Timestamptz(6)
  reviewText          String?   @map("review_text")
  reviewSentiment     String?   @map("review_sentiment")
  reviewAdjustedScore Decimal?  @map("review_adjusted_score") @db.Decimal(3, 1)
  socialReach         Json?     @map("social_reach")
  referralsGenerated  Int       @default(0) @map("referrals_generated")

  // Stage transition dates (migration 007)
  inquiredAt   DateTime? @map("inquired_at") @db.Date
  touredAt     DateTime? @map("toured_at") @db.Date
  heldAt       DateTime? @map("held_at") @db.Date
  contractedAt DateTime? @map("contracted_at") @db.Date

  // Hold & loss (migration 011)
  holdExpiresAt  DateTime? @map("hold_expires_at") @db.Timestamptz(6)
  lostReason     String?   @map("lost_reason")
  lostReasonNote String?   @map("lost_reason_note")

  // Consultant assignment (migration 010)
  assignedTo     String?   @map("assigned_to") @db.Uuid

  // HoneyBook integration (migration 014)
  honeyBookProjectId String?   @map("honeybook_project_id")
  inquiryDate        DateTime? @map("inquiry_date") @db.Timestamptz(6)

  // Review request sequence (migration 018)
  reviewRequestedAt  DateTime? @map("review_requested_at") @db.Timestamptz(6)
  reviewRequestCount Int       @default(0) @map("review_request_count")
  reviewSubmitted    Boolean   @default(false) @map("review_submitted")
  reviewSubmittedAt  DateTime? @map("review_submitted_at") @db.Timestamptz(6)

  // Referral tracking (migration 018)
  referralCount    Int       @default(0) @map("referral_count")
  referralNotedAt  DateTime? @map("referral_noted_at") @db.Timestamptz(6)

  // Post-wedding sequence (migration 018)
  postWeddingDay2Sent         DateTime? @map("post_wedding_day2_sent") @db.Timestamptz(6)
  postWeddingDay14Sent        DateTime? @map("post_wedding_day14_sent") @db.Timestamptz(6)
  postWeddingDay30Sent        DateTime? @map("post_wedding_day30_sent") @db.Timestamptz(6)
  postWeddingDay90Sent        DateTime? @map("post_wedding_day90_sent") @db.Timestamptz(6)
  postWeddingAnniversarySent  DateTime? @map("post_wedding_anniversary_sent") @db.Timestamptz(6)

  // Relations — original
  venue             Venue                    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  referrer          Client?                  @relation("ClientReferrals", fields: [referrerClientId], references: [id])
  referredClients   Client[]                 @relation("ClientReferrals")
  sourceTouchpoints ClientSourceTouchpoint[]
  inquiries         Inquiry[]
  tours             Tour[]
  uploads           Upload[]
  planningEvents    PlanningEvent[]
  clientVendors     ClientVendor[]
  weatherForecasts  WeatherForecast[]
  matchingQueueA    MatchingQueue[]          @relation("MatchQueueRecordA")
  matchingQueueB    MatchingQueue[]          @relation("MatchQueueRecordB")
  // Relations — added (migrations 005, 018)
  leads             Lead[]
  reviews           Review[]
  referralsGiven    Referral[]               @relation("ReferralFrom")
  referralsReceived Referral[]               @relation("ReferralTo")
  // Relations — new models
  lostDeals           LostDeal[]
  contentTouchpoints  ContentTouchpoint[]
  emailThreads        EmailThread[]
  websiteSessions     WebsiteSession[]        @relation("WebsiteSessionClient")

  @@map("clients")
}

// ============================================================
// CLIENT SOURCE TOUCHPOINTS
// ============================================================
model ClientSourceTouchpoint {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  venueId       String    @map("venue_id") @db.Uuid
  platform      String
  touchpointDate DateTime? @map("touchpoint_date") @db.Timestamptz(6)
  campaignId    String?   @map("campaign_id")
  campaignName  String?   @map("campaign_name")
  costCents     Int?      @map("cost_cents")
  rawData       Json?     @map("raw_data")
  // Touchpoint classification (migration 017)
  touchpointType String?  @map("touchpoint_type")
  confidence     String?  @default("confirmed")
  signalSource   String?  @default("manual") @map("signal_source")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  venue  Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("client_source_touchpoints")
}

// ============================================================
// INQUIRIES
// ============================================================
model Inquiry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Source
  platform   String
  externalId String? @map("external_id")
  rawMessage String? @map("raw_message")

  // Extracted signals
  nameExtracted      String?   @map("name_extracted")
  emailExtracted     String?   @map("email_extracted")
  phoneExtracted     String?   @map("phone_extracted")
  eventDateExtracted DateTime? @map("event_date_extracted") @db.Date
  budgetExtracted    Int?      @map("budget_extracted")
  guestCountExtracted Int?     @map("guest_count_extracted")

  // Timing
  receivedAt  DateTime? @map("received_at") @db.Timestamptz(6)
  dayOfWeek   Int?      @map("day_of_week")
  hourOfDay   Int?      @map("hour_of_day")

  // Attribution
  campaignId          String? @map("campaign_id")
  sessionData         Json?   @map("session_data")
  selfReportedSource  String? @map("self_reported_source")
  sessionSourceUrl    String? @map("session_source_url")
  resolvedSource      String? @map("resolved_source")
  resolvedSourceConfidence Int? @map("resolved_source_confidence")

  // Matching
  matchedClientId   String? @map("matched_client_id") @db.Uuid
  matchConfidence   Int?    @map("match_confidence")
  matchStatus       String  @default("unmatched") @map("match_status")

  // Response
  responseSentAt       DateTime? @map("response_sent_at") @db.Timestamptz(6)
  responseTimeMinutes  Int?      @map("response_time_minutes")

  // Consultant assignment (migration 010)
  assignedTo                 String?  @map("assigned_to") @db.Uuid

  // Touchpoint attribution (migration 017)
  inquiryIntent              String?  @default("unknown") @map("inquiry_intent")
  firstContactChannel        String?  @map("first_contact_channel")
  touchpointClassification   String?  @default("unknown") @map("touchpoint_classification")
  priorSignalId              String?  @map("prior_signal_id") @db.Uuid
  priorSignalConfidence      Int?     @map("prior_signal_confidence")
  priorSignalStatus          String?  @default("not_searched") @map("prior_signal_status")
  daysFromSignalToInquiry    Int?     @map("days_from_signal_to_inquiry")

  venue             Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matchedClient     Client?           @relation(fields: [matchedClientId], references: [id])
  // preInquirySignals that matched to this inquiry
  preInquirySignals PreInquirySignal[]
  // referrals that arrived through this inquiry
  referrals         Referral[]
  // New model relations
  responseAlerts    ResponseAlert[]
  lostDeals         LostDeal[]

  @@map("inquiries")
}

// ============================================================
// TOURS
// ============================================================
model Tour {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  tourType   String?  @map("tour_type")
  completed  Boolean  @default(false)
  cancelled  Boolean  @default(false)
  cancelReason String? @map("cancel_reason")

  // Intake
  selfReportedSource String?  @map("self_reported_source")
  competingVenues    String[] @map("competing_venues")

  // Upload
  uploadId  String? @map("upload_id") @db.Uuid
  notesRaw  String? @map("notes_raw")

  // Outcome
  bookingDate           DateTime? @map("booking_date") @db.Date
  bookingConversionDays Int?      @map("booking_conversion_days")

  // Consultant assignment (migration 010)
  assignedTo   String? @map("assigned_to") @db.Uuid

  // Invitee fields from Calendly sync (migration 014)
  inviteeName  String? @map("invitee_name")
  inviteeEmail String? @map("invitee_email")
  inviteePhone String? @map("invitee_phone")
  inviteeQa    Json?   @map("invitee_qa")
  externalId   String? @map("external_id")
  source       String?

  venue  Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])

  @@map("tours")
}

// ============================================================
// UPLOADS
// ============================================================
model Upload {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  clientId  String?  @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // File
  fileName      String? @map("file_name")
  fileType      String? @map("file_type")
  fileSizeBytes Int?    @map("file_size_bytes")
  storagePath   String? @map("storage_path")

  // Processing
  status             String @default("pending")
  transcript         String?
  extractedSignals   Json?  @map("extracted_signals")
  confirmedSignals   Json?  @map("confirmed_signals")

  // Metadata
  uploadType  String?   @map("upload_type")
  uploadDate  DateTime? @map("upload_date") @db.Timestamptz(6)

  venue  Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])

  @@map("uploads")
}

// ============================================================
// PLANNING EVENTS
// ============================================================
model PlanningEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  eventType String   @map("event_type")
  eventDate DateTime? @map("event_date") @db.Timestamptz(6)
  metadata  Json?
  source    String?

  venue  Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("planning_events")
}

// ============================================================
// VENDORS
// ============================================================
model Vendor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name      String
  category  String?
  email     String?
  website   String?

  // Scorecard (calculated monthly)
  appearancesCount          Int       @default(0)   @map("appearances_count")
  avgReviewScore            Decimal?  @map("avg_review_score") @db.Decimal(3, 1)
  avgComplexityScore        Int?      @map("avg_complexity_score")
  referralsSent12m          Int       @default(0)   @map("referrals_sent_12m")
  referralRevenueCents12m   Int       @default(0)   @map("referral_revenue_cents_12m")
  referralConversionRate    Decimal?  @map("referral_conversion_rate") @db.Decimal(4, 2)
  lastScorecardAt           DateTime? @map("last_scorecard_at") @db.Timestamptz(6)

  venue         Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  clientVendors ClientVendor[]
  availability  VendorAvailability[]

  @@map("vendors")
}

// ============================================================
// CLIENT VENDORS (junction)
// ============================================================
model ClientVendor {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId  String @map("venue_id") @db.Uuid
  clientId String @map("client_id") @db.Uuid
  vendorId String @map("vendor_id") @db.Uuid

  venue  Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([clientId, vendorId])
  @@map("client_vendors")
}

// ============================================================
// ANNOTATIONS
// ============================================================
model Annotation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  // Period
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  // Classification
  annotationType String  @map("annotation_type")
  categoryDetail String? @map("category_detail")
  notes          String?

  // Origin
  source String @default("human_proactive")

  // Detection context
  detectedSignal    String?  @map("detected_signal")
  detectedValue     Decimal? @map("detected_value") @db.Decimal(10, 2)
  detectedThreshold Decimal? @map("detected_threshold") @db.Decimal(10, 2)

  // Treatment
  excludeFromPatterns Boolean @default(false) @map("exclude_from_patterns")
  excludeReason       String? @map("exclude_reason")
  propagateToAggregate Boolean @default(true) @map("propagate_to_aggregate")

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("annotations")
}

// ============================================================
// WEATHER DATA
// ============================================================
model WeatherMonthly {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noaaStationId  String  @map("noaa_station_id")
  year           Int
  month          Int
  precipitationInches Decimal? @map("precipitation_inches") @db.Decimal(6, 2)
  tempAvgF       Decimal? @map("temp_avg_f") @db.Decimal(5, 1)
  tempMaxF       Decimal? @map("temp_max_f") @db.Decimal(5, 1)
  tempMinF       Decimal? @map("temp_min_f") @db.Decimal(5, 1)
  daysPrecipitation Int?  @map("days_precipitation")
  weatherScore   Int?    @map("weather_score")

  @@unique([noaaStationId, year, month])
  @@map("weather_monthly")
}

model WeatherDaily {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  noaaStationId  String   @map("noaa_station_id")
  date           DateTime @db.Date
  precipitationInches Decimal? @map("precipitation_inches") @db.Decimal(6, 2)
  tempMaxF       Decimal? @map("temp_max_f") @db.Decimal(5, 1)
  tempMinF       Decimal? @map("temp_min_f") @db.Decimal(5, 1)
  conditions     String?
  difficultyScore Int?    @map("difficulty_score")

  @@unique([noaaStationId, date])
  @@map("weather_daily")
}

model WeatherForecast {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId         String   @map("venue_id") @db.Uuid
  clientId        String?  @map("client_id") @db.Uuid
  forecastDate    DateTime @map("forecast_date") @db.Date
  pulledAt        DateTime @map("pulled_at") @db.Timestamptz(6)
  precipProbability Int?   @map("precip_probability")
  tempHighF       Int?     @map("temp_high_f")
  tempLowF        Int?     @map("temp_low_f")
  conditions      String?
  alertTriggered  Boolean  @default(false) @map("alert_triggered")

  venue  Venue   @relation(fields: [venueId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])

  @@map("weather_forecasts")
}

// ============================================================
// MACRO SIGNALS
// ============================================================
model MacroEconomic {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signalType  String   @map("signal_type")
  periodDate  DateTime @map("period_date") @db.Date
  value       Decimal? @db.Decimal(10, 4)
  geoScope    String   @map("geo_scope")
  rawData     Json?    @map("raw_data")

  @@unique([signalType, periodDate, geoScope])
  @@map("macro_economic")
}

model MacroDemographic {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fipsCode         String  @map("fips_code")
  year             Int
