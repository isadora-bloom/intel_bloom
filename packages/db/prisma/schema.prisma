  healthScore         Int?      @map("health_score")
  status              String?
  bookingPaceScore    Int?      @map("booking_pace_score")
  conversionScore     Int?      @map("conversion_score")
  responseTimeScore   Int?      @map("response_time_score")
  reviewTrendScore    Int?      @map("review_trend_score")
  inquiryTrendScore   Int?      @map("inquiry_trend_score")
  lostDealScore       Int?      @map("lost_deal_score")
  alerts              Json?
  recommendations     Json?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_health")
}

// ============================================================
// VENUE CAPACITY — monthly capacity tracking
// ============================================================
model VenueCapacity {
