// ============================================================
// CONTENT TOUCHPOINTS — content interaction tracking
// ============================================================
model ContentTouchpoint {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venueId                 String    @map("venue_id") @db.Uuid
  clientId                String?   @map("client_id") @db.Uuid
  contentType             String    @map("content_type")
  contentId               String?   @map("content_id")
  contentTitle            String?   @map("content_title")
  touchpointDate          DateTime? @map("touchpoint_date") @db.Timestamptz(6)
  interactionType         String?   @map("interaction_type")
  inBookingJourney        Boolean   @default(false) @map("in_booking_journey")
