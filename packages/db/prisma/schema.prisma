  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  matchedInquiry Inquiry? @relation(fields: [matchedInquiryId], references: [id], onDelete: SetNull)

  @@unique([venueId, platform, firstName, lastInitial, signalType, occurredAt])
  @@map("pre_inquiry_signals")
}

