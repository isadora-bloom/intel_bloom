  venueId                     String    @map("venue_id") @db.Uuid
  month                       DateTime  @db.Date
  year                        Int
  totalAvailableDates         Int?      @map("total_available_dates")
  bookedDates                 Int?      @map("booked_dates")
  heldDates                   Int?      @map("held_dates")
  occupancyPct                Decimal?  @map("occupancy_pct") @db.Decimal(5, 2)
  avgRevenuePerEventCents     Int?      @map("avg_revenue_per_event_cents")
  potentialRevenueCents       Int?      @map("potential_revenue_cents")
  isPeak                      Boolean?  @map("is_peak")
  suggestedPriceAdjustmentPct Decimal?  @map("suggested_price_adjustment_pct") @db.Decimal(5, 2)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_capacity")
}

