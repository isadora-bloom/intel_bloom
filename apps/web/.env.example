# ============================================================
# Bloom Intelligence — Environment Variables
# Copy this file to .env.local and fill in your values.
# See SETUP_CHECKLIST.md for where to get each key.
# ============================================================

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# AI (required for extraction and Sage chat)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # Whisper transcription for tour recordings

# App URL (required — no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                 # generate: openssl rand -hex 32

# Stripe billing (required for paid plans)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...  # From Stripe Dashboard → Webhooks
STRIPE_PRICE_ID=price_...        # Create a $250/month product in Stripe first

# Email — Resend (required for briefing emails and post-wedding sequence)
RESEND_API_KEY=re_...
BRIEFING_FROM_EMAIL=briefing@yourdomain.com  # Must be a verified domain in Resend

# Google OAuth — Gmail integration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google Places — venue geocoding (optional but recommended)
GOOGLE_PLACES_API_KEY=           # Google Cloud Console → Places API
                                  # Without this, onboarding uses state-level defaults

# Public data APIs (all free)
NOAA_CDO_TOKEN=                  # https://www.ncdc.noaa.gov/cdo-web/token
FRED_API_KEY=                    # https://fred.stlouisfed.org/docs/api/api_key.html
CENSUS_API_KEY=                  # https://api.census.gov/data/key_signup.html

# HoneyBook integration (optional)
HONEYBOOK_CLIENT_ID=
HONEYBOOK_CLIENT_SECRET=

# Cron security (required — any random string)
CRON_SECRET=                     # generate: openssl rand -hex 32

# Supabase Storage bucket name
SUPABASE_STORAGE_BUCKET=bloom-uploads

# Sentry error monitoring (optional — app works without it)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel (auto-set in production, leave blank locally)
VERCEL_URL=
