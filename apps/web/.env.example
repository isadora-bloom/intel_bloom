# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# AI
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # For Whisper transcription

# Public Data APIs (all free)
NOAA_CDO_TOKEN=                  # https://www.ncdc.noaa.gov/cdo-web/token
FRED_API_KEY=                    # https://fred.stlouisfed.org/docs/api/api_key.html
CENSUS_API_KEY=                  # https://api.census.gov/data/key_signup.html
GOOGLE_PLACES_API_KEY=           # Google Cloud Console — Places API

# Integrations
HONEYBOOK_CLIENT_ID=
HONEYBOOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=          # For Gmail OAuth
GOOGLE_OAUTH_CLIENT_SECRET=

# Cron security
CRON_SECRET=generate-a-random-secret-here

# Storage
SUPABASE_STORAGE_BUCKET=bloom-uploads

# App
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Vercel
VERCEL_URL=
